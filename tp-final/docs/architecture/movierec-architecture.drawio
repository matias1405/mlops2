        <mxCell id="p2-step-9-desc-legend" value="&lt;div&gt;&lt;b&gt;PROD sirve el modelo&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Usuarios finales usan el modelo nuevo en :80 sin reiniciar el recommender.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p2-step-9-legend"><mxGeometry x="52" y="0" width="548" height="58" as="geometry" /></mxCell>
