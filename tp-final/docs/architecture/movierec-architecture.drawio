        <mxCell id="p1-step-1-desc-legend" value="&lt;div&gt;&lt;b&gt;Acceso a PROD&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;El navegador abre nginx web-prod en :80 (público): sirve el React estático y hace proxy de /api y /media.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p1-step-1-legend"><mxGeometry x="52" y="0" width="548" height="66" as="geometry" /></mxCell>
        <mxCell id="p1-step-2-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="p1-legend-container"><mxGeometry height="66" width="600" x="0" y="72" as="geometry" /></mxCell>
