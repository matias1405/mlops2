        <mxCell id="p3-step-1-badge-legend" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="p3-step-1-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="p3-step-1-desc-legend" value="&lt;div&gt;&lt;b&gt;Provisión&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Terraform crea VPC, subnet pública, Security Group, EC2 con user_data (clona el repo y corre docker compose), bucket S3 y rol IAM.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p3-step-1-legend"><mxGeometry x="52" y="0" width="548" height="66" as="geometry" /></mxCell>
        <mxCell id="p3-step-2-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="p3-legend-container"><mxGeometry height="66" width="600" x="0" y="72" as="geometry" /></mxCell>
        <mxCell id="p3-step-2-badge-legend" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="p3-step-2-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="p3-step-2-desc-legend" value="&lt;div&gt;&lt;b&gt;Acceso público&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Usuarios finales llegan a nginx web-prod (:80) y a Keycloak (:8180) por la IP pública de la instancia.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p3-step-2-legend"><mxGeometry x="52" y="0" width="548" height="66" as="geometry" /></mxCell>
        <mxCell id="p3-step-3-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="p3-legend-container"><mxGeometry height="66" width="600" x="0" y="144" as="geometry" /></mxCell>
        <mxCell id="p3-step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="p3-step-3-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="p3-step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;Entrada a la instancia&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;El Internet Gateway enruta al EC2; no hay ALB ni NAT Gateway para minimizar costo.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p3-step-3-legend"><mxGeometry x="52" y="0" width="548" height="66" as="geometry" /></mxCell>
        <mxCell id="p3-step-4-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="p3-legend-container"><mxGeometry height="66" width="600" x="0" y="216" as="geometry" /></mxCell>
        <mxCell id="p3-step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="p3-step-4-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="p3-step-4-desc-legend" value="&lt;div&gt;&lt;b&gt;Data lake en S3&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;MinIO se reemplaza por S3 cambiando endpoint y credenciales en el .env; el EC2 accede con su rol IAM.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p3-step-4-legend"><mxGeometry x="52" y="0" width="548" height="66" as="geometry" /></mxCell>
        <mxCell id="p3-step-5-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="p3-legend-container"><mxGeometry height="66" width="600" x="0" y="288" as="geometry" /></mxCell>
        <mxCell id="p3-step-5-badge-legend" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="p3-step-5-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="p3-step-5-desc-legend" value="&lt;div&gt;&lt;b&gt;Accesos internos&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;DEV (8081), Airflow (8080) y MLflow (5050) no se exponen: el equipo usa SSM Session Manager port forwarding.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p3-step-5-legend"><mxGeometry x="52" y="0" width="548" height="66" as="geometry" /></mxCell>
        <mxCell id="p3-step-6-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="p3-legend-container"><mxGeometry height="66" width="600" x="0" y="360" as="geometry" /></mxCell>
        <mxCell id="p3-step-6-badge-legend" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="p3-step-6-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="p3-step-6-desc-legend" value="&lt;div&gt;&lt;b&gt;Salida a Internet&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Airflow descarga de Kaggle y el gateway trae posters de TMDB vía el Internet Gateway.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p3-step-6-legend"><mxGeometry x="52" y="0" width="548" height="66" as="geometry" /></mxCell>
