        <mxCell id="p1-step-2-desc-legend" value="&lt;div&gt;&lt;b&gt;Login OIDC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;keycloak-js (PKCE) contra Keycloak :8180, realm movierec (registro abierto, rol movierec-user).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p1-step-2-legend"><mxGeometry x="52" y="0" width="548" height="66" as="geometry" /></mxCell>
        <mxCell id="p1-step-3-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="p1-legend-container"><mxGeometry height="66" width="600" x="0" y="144" as="geometry" /></mxCell>
        <mxCell id="p1-step-3-badge-legend" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="p1-step-3-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="p1-step-3-desc-legend" value="&lt;div&gt;&lt;b&gt;REST + JWT&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;React llama /api; el gateway valida el JWT contra el JWKS de Keycloak (iss del realm, azp del client y roles del ambiente).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p1-step-3-legend"><mxGeometry x="52" y="0" width="548" height="66" as="geometry" /></mxCell>
        <mxCell id="p1-step-4-legend" connectable="0" style="group;fontFamily=Helvetica;" value="" vertex="1" parent="p1-legend-container"><mxGeometry height="66" width="600" x="0" y="216" as="geometry" /></mxCell>
        <mxCell id="p1-step-4-badge-legend" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="p1-step-4-legend"><mxGeometry x="0" y="2" width="40" height="38" as="geometry" /></mxCell>
        <mxCell id="p1-step-4-desc-legend" value="&lt;div&gt;&lt;b&gt;Predicción gRPC&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;gateway → recommender con las 5 elegidas: 3 vecinos coseno por elegida, z-score por semilla y las 12 mejores, cada una con su porqué (because_of).&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="p1-step-4-legend"><mxGeometry x="52" y="0" width="548" height="66" as="geometry" /></mxCell>
