# Ambiente DEV (no público). Sin secretos: los toma de platform.env.
ENV_NAME=dev
MODEL_ALIAS=dev
# Base del ambiente y usuario de MinIO del gateway (los secretos se toman de platform.env).
APP_DB_NAME=app_dev
APP_DB_PASSWORD=${APP_DEV_DB_PASSWORD}
MINIO_GATEWAY_USER=gateway-dev
MINIO_GATEWAY_SECRET=${MINIO_GATEWAY_DEV_SECRET}
# Auth: DEV usa el realm del equipo (no público). qa-bot hace smoke tests.
AUTH_REALM=platform
AUTH_ALLOWED_CLIENTS=movierec-web-dev,qa-bot
AUTH_REQUIRED_ROLES=data-scientist,ml-engineer,app-developer
# Frontend: nginx solo en localhost; client público del realm platform.
WEB_BIND=127.0.0.1:8081
WEB_CLIENT_ID=movierec-web-dev
