# Ambiente PROD (público).
ENV_NAME=prod
MODEL_ALIAS=production
APP_DB_NAME=app_prod
APP_DB_PASSWORD=${APP_PROD_DB_PASSWORD}
MINIO_GATEWAY_USER=gateway-prod
MINIO_GATEWAY_SECRET=${MINIO_GATEWAY_PROD_SECRET}
# Auth: PROD usa el realm de usuarios finales.
AUTH_REALM=movierec
AUTH_ALLOWED_CLIENTS=movierec-web
AUTH_REQUIRED_ROLES=movierec-user
# Frontend: nginx público en el puerto 80; client público del realm movierec.
WEB_BIND=0.0.0.0:80
WEB_CLIENT_ID=movierec-web
