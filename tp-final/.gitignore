data/sample/*
!data/sample/tmdb_sample.csv

# Volúmenes locales y artefactos
volumes/
mlruns/
*.ckpt
*.pt

# Node / frontend
node_modules/
services/web/dist/

# Entornos locales
.venv/
.env

# Reportes locales (escaneos de seguridad)
reports/
.playwright-mcp/

# Material de desarrollo de la plataforma (no forma parte de la entrega)
dev.mk
scripts/verify_*
scripts/check_secrets.py
scripts/gen_proto.sh
scripts/run_dag.sh
