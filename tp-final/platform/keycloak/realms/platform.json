{
  "realm": "platform",
  "displayName": "MovieRec · Plataforma (equipo)",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "data-scientist",
        "description": "Datos y modelos: ingesta, data lake, experimentos y entrenamiento"
      },
      {
        "name": "ml-engineer",
        "description": "Promoción de modelos y operación de la plataforma"
      },
      {
        "name": "app-developer",
        "description": "Desarrollo de gateway, recommender y frontend"
      },
      {
        "name": "model-deployer",
        "description": "Puede invocar Reload en los recommenders (M2M)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "airflow",
      "name": "Airflow UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_AIRFLOW_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/oauth-authorized/keycloak",
        "http://127.0.0.1:8080/oauth-authorized/keycloak"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "mlflow-proxy",
      "name": "MLflow UI (oauth2-proxy)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_MLFLOW_PROXY_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5050/oauth2/callback",
        "http://127.0.0.1:5050/oauth2/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "audience mlflow-proxy",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mlflow-proxy",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email",
        "roles"
      ]
    },
    {
      "clientId": "movierec-web-dev",
      "name": "Frontend DEV (solo equipo)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8081/*",
        "http://127.0.0.1:8081/*"
      ],
      "webOrigins": [
        "http://localhost:8081",
        "http://127.0.0.1:8081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8081/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "airflow-deployer",
      "name": "Service account de Airflow (Reload de recommenders)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_AIRFLOW_DEPLOYER_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "qa-bot",
      "name": "Service account de smoke tests contra DEV",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_QA_BOT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ds_user",
      "enabled": true,
      "emailVerified": true,
      "email": "ds_user@movierec.local",
      "firstName": "Data",
      "lastName": "Scientist",
      "credentials": [
        {
          "type": "password",
          "value": "ds_user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-platform",
        "data-scientist"
      ]
    },
    {
      "username": "mle_user",
      "enabled": true,
      "emailVerified": true,
      "email": "mle_user@movierec.local",
      "firstName": "ML",
      "lastName": "Engineer",
      "credentials": [
        {
          "type": "password",
          "value": "mle_user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-platform",
        "ml-engineer"
      ]
    },
    {
      "username": "dev_user",
      "enabled": true,
      "emailVerified": true,
      "email": "dev_user@movierec.local",
      "firstName": "App",
      "lastName": "Developer",
      "credentials": [
        {
          "type": "password",
          "value": "dev_user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-platform",
        "app-developer"
      ]
    },
    {
      "username": "service-account-airflow-deployer",
      "enabled": true,
      "serviceAccountClientId": "airflow-deployer",
      "realmRoles": [
        "default-roles-platform",
        "model-deployer"
      ]
    },
    {
      "username": "service-account-qa-bot",
      "enabled": true,
      "serviceAccountClientId": "qa-bot",
      "realmRoles": [
        "default-roles-platform",
        "app-developer"
      ]
    }
  ]
}
