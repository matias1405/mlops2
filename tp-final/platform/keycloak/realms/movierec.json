{
  "realm": "movierec",
  "displayName": "MovieRec · Recomendaciones",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "movierec-user",
        "description": "Usuario final de la app de recomendaciones"
      },
      {
        "name": "default-roles-movierec",
        "description": "Roles asignados a todo usuario nuevo (incluye movierec-user al registrarse)",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "movierec-user"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-movierec"
  },
  "clients": [
    {
      "clientId": "movierec-web",
      "name": "Frontend PROD",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "webOrigins": [
        "http://localhost",
        "http://127.0.0.1"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "client_user",
      "enabled": true,
      "emailVerified": true,
      "email": "client_user@movierec.local",
      "firstName": "Client",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "client_user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-movierec"
      ]
    }
  ]
}
