# Plantilla de variables de la plataforma ML compartida.
# `make secrets` genera platform.env reemplazando cada <generate> por un valor aleatorio.
# platform.env NO se versiona (ver .gitignore).
# Plataforma de demo, solo local: las contraseñas que escribe una persona (admin de Keycloak, root de MinIO y
# usuarios demo de los realms) son iguales al nombre de usuario. Los secretos entre servicios son aleatorios.
# Para un uso real, reemplazá esas contraseñas por <generate>.

# --- PostgreSQL (una base y un usuario por servicio) -------------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=<generate>
AIRFLOW_DB_PASSWORD=<generate>
MLFLOW_DB_PASSWORD=<generate>
KEYCLOAK_DB_PASSWORD=<generate>
APP_DEV_DB_PASSWORD=<generate>
APP_PROD_DB_PASSWORD=<generate>

# --- MinIO (root solo para el init; cada servicio usa su propio usuario) -----
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=minio-admin
MINIO_AIRFLOW_SECRET=<generate>
MINIO_MLFLOW_SECRET=<generate>
MINIO_GATEWAY_DEV_SECRET=<generate>
MINIO_GATEWAY_PROD_SECRET=<generate>

# --- Airflow -------------------------------------------------------------------
AIRFLOW_FERNET_KEY=<generate:fernet>
AIRFLOW_SECRET_KEY=<generate>
# Sin usuario local: el login de la UI es con Keycloak (realm platform).

# --- Keycloak ---------------------------------------------------------
KEYCLOAK_ADMIN_USER=kc-admin
KEYCLOAK_ADMIN_PASSWORD=kc-admin
# URL pública única: es el issuer (iss) de todos los tokens. Los servicios internos llegan por
# http://keycloak:8080 (backchannel dinámico) pero validan contra este issuer.
KEYCLOAK_PUBLIC_URL=http://localhost:8180
KEYCLOAK_PORT=8180
KC_AIRFLOW_CLIENT_SECRET=<generate>
KC_MLFLOW_PROXY_CLIENT_SECRET=<generate>
KC_AIRFLOW_DEPLOYER_SECRET=<generate>
KC_QA_BOT_SECRET=<generate>
OAUTH2_PROXY_COOKIE_SECRET=<generate>

# --- Puertos publicados ----------------------------------------------------------
# Solo en 127.0.0.1, salvo Keycloak (público en KEYCLOAK_PORT: lo usan los usuarios finales).
AIRFLOW_PORT=8080
# MLflow UI detrás de oauth2-proxy (login con Keycloak, realm platform).
MLFLOW_PORT=5050
MINIO_CONSOLE_PORT=9001

# --- Primera carga (DAG bootstrap, corre sola al primer arranque de Airflow) -----
# kaggle: API pública sin credenciales | local: data/raw/TMDB_movie_dataset_v11.csv | sample: data/sample
MOVIEREC_BOOTSTRAP_SOURCE=kaggle
